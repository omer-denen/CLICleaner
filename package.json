{
  "name": "clicleaner",
  "version": "2.0.0",
  "description": "CLI cleaner and evidence-first auditor for developer caches, CLI installs and AI runtime leftovers; shows what each folder is before anything is deleted",
  "type": "module",
  "license": "MIT",
  "author": "CLICleaner contributors",
  "keywords": [
    "cli-cleaner",
    "cli-temizleyici",
    "clicleaner",
    "cli-tools",
    "cli-cache",
    "developer-tools",
    "devtools",
    "cache-analyzer",
    "disk-usage",
    "ai-agents",
    "ai-tools",
    "ai-artifacts",
    "npm-cache",
    "nuget",
    "conda",
    "python",
    "onnx",
    "cuda",
    "nodejs",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omer-denen/CLICleaner.git"
  },
  "homepage": "https://github.com/omer-denen/CLICleaner#readme",
  "bugs": {
    "url": "https://github.com/omer-denen/CLICleaner/issues"
  },
  "os": [
    "win32"
  ],
  "files": [
    "bin/",
    "src/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "clicleaner": "./bin/clicleaner.mjs"
  },
  "scripts": {
    "scan": "tsx src/cli.ts scan",
    "ui": "tsx src/cli.ts ui",
    "api": "tsx src/cli.ts api",
    "inventory": "tsx src/cli.ts inventory",
    "clean": "tsx src/cli.ts clean",
    "explain": "tsx src/cli.ts explain",
    "rules": "tsx src/cli.ts rules",
    "doctor": "tsx src/cli.ts doctor",
    "undo": "tsx src/cli.ts undo",
    "typecheck": "tsc --noEmit",
    "preversion": "npm run typecheck",
    "release:patch": "npm version patch -m \"surum: v%s\"",
    "release:minor": "npm version minor -m \"surum: v%s\"",
    "release:major": "npm version major -m \"surum: v%s\"",
    "start": "tsx src/cli.ts",
    "status": "tsx src/cli.ts status",
    "log": "tsx src/cli.ts log",
    "init-state": "tsx scripts/init-state.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "tsx": "^4.23.15"
  }
}
